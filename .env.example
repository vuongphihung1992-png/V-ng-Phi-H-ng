# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL for the application.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Optional for production cloud persistence)
# Leave empty to automatically fallback to DEMO MODE with client persistence
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# DEMO MODE FLAG (Set to 'false' in production when Supabase keys are set)
VITE_DEMO_MODE=true

# GOOGLE ANALYTICS (GA4) MEASUREMENT ID
# Used for tracking citizen visits and utility feature metrics for Pơng Drang Commune Police
VITE_GA_MEASUREMENT_ID=G-PONGDRANG2026
